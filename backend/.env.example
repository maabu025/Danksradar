# Server
HOST=0.0.0.0
PORT=1337
# Public address of this backend (no trailing slash)
PUBLIC_URL=http://localhost:1337

# Secrets: replace each with a long random value (e.g. run: openssl rand -base64 32)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# MySQL database
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=danksradar
DATABASE_USERNAME=danksradar
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Website address(es) allowed to call this API, comma-separated
FRONTEND_URL=http://localhost:3000

# Email (Resend). Leave empty during development to skip sending.
RESEND_API_KEY=
EMAIL_FROM=Danksradar <no-reply@danksradar.com>
SALES_EMAIL=sales@danksradar.com

# Cloudflare Turnstile secret key. Leave empty to turn spam checks off in development.
TURNSTILE_SECRET_KEY=
