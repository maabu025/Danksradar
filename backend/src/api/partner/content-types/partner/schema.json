{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "Jimi IoT, Targa Telematics, Teltonika, Lytx"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "darkLogoBg": {
      "type": "boolean",
      "default": false
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "strategic_partner",
        "authorised_distributor",
        "technology_partner"
      ],
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 160
    },
    "website": {
      "type": "string"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "partner"
    },
    "platforms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::platform.platform",
      "mappedBy": "partner"
    }
  }
}